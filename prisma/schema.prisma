// Turmagram: a rede social da turma
// As tabelas (models) vão ser criadas durante as aulas, aqui embaixo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}


model Usuario {
  id Int @id @default(autoincrement())
  nome String @unique
  avatar String
  criadoEm DateTime @default(now())
  posts Post[]
  curtidas  Curtida[]
  comentarios Comentario[]
}

model Post {
  id Int @id @default(autoincrement())
  imagem String
  legenda String
  criadoEm DateTime @default(now())

  autorId Int
  autor Usuario @relation(fields: [autorId], references: [id])

  curtidas Curtida[]
  comentatios Comentario[]
}

model Curtida {

  usuarioId Int
  postId Int
  criadoEm DateTime @default(now())

  usuario Usuario @relation (fields: [usuarioId], references: [id], onDelete: Cascade)
  post Post @relation (fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId,usuarioId])
}

model Comentario{
  id Int @id @default(autoincrement())
  texto String
  criadoEm DateTime @default(now())

  autorId Int
  autor Usuario @relation(fields: [autorId], references: [id], onDelete: Cascade)

  postId Int
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

}



