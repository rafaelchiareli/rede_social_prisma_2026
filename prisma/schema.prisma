// Turmagram: a rede social da turma
// As tabelas (models) vão ser criadas durante as aulas, aqui embaixo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}


model Usuario {
  id Int @id @default(autoincrement())
  nome String @unique
  avatar String
  criadoEm DateTime @default(now())
  perfil Perfil?
  posts Post[]
  curtidas  Curtida[]
  comentarios Comentario[]
}

model Perfil {
  id Int @id @default (autoincrement())
  bio String

  usuarioId Int @unique
  usuario Usuario @relation (fields :[usuarioId], references: [id], onDelete: Cascade)
}



model Post {
  id Int @id @default(autoincrement())
  imagem String
  legenda String
  criadoEm DateTime @default(now())

  autorId Int
  autor Usuario @relation(fields: [autorId], references: [id], onDelete: Cascade)

  curtidas Curtida[]
  comentarios Comentario[]
  tags Tag[]
}

model Tag {
  id Int @id @default(autoincrement())
  nome String @unique

  posts Post[]
}

model Curtida {

  usuarioId Int
  postId Int
  criadoEm DateTime @default(now())

  usuario Usuario @relation (fields: [usuarioId], references: [id], onDelete: Cascade)
  post Post @relation (fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId,usuarioId])
}

model Comentario{
  id Int @id @default(autoincrement())
  texto String
  criadoEm DateTime @default(now())

  autorId Int
  autor Usuario @relation(fields: [autorId], references: [id], onDelete: Cascade)

  postId Int
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

}



