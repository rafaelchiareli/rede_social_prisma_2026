// Turmagram: a rede social da turma
// Aula 1: usuários e posts (relação 1 para N)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String   @unique
  avatar   String
  criadoEm DateTime @default(now())

  posts Post[]
}

model Post {
  id       Int      @id @default(autoincrement())
  imagem   String
  legenda  String
  criadoEm DateTime @default(now())

  autorId Int
  autor   Usuario @relation(fields: [autorId], references: [id])
}
